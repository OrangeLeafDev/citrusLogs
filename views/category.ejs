<%- include('header') %>

<span><a href="/">← back</a></span>
<div class="banner-title">
    <img src="<%= category.thumbnail %>" alt="<%= category.name %>" class="bg-image" onerror="this.style.display='none';">
    <div class="text-highlight">
        <h1><%= category.name %></h1>
        <div class="contents">
            <p><%= category.description %></p>
        </div>
    </div>
</div>
<div class="contents">
    <%- category.htmlContent %>
</div>

<h2>posts</h2>
<div class="postbar-container">
    <% for (const post of posts) { %>
        <div class="postbar">
            <div class="image-wrapper" id="post">
                <img src="<%= post.thumbnail %>" alt="<%= post.title %>" id="post" onerror="this.closest('.image-wrapper').style.display='none';">
            </div>
            <div class="text-wrapper">
                <a href="/<%= category.slug %>/<%= post.slug %>" class="invis-link">
                    <h1><%= post.title %></h1>
                </a>
            </div>
            <div class="meta-wrapper"><%= post.author %> | <%= post.date %></div>
        </div>
    <% } %>
</div>

<%- include('footer') %>